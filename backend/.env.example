# Configuración del Backend Alcalde Tracker Quito

# --- PostgreSQL (opcional; sin estas variables usa la base en memoria) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alcalde_tracker
# O bien variables sueltas:
# PGHOST=localhost
# PGDATABASE=alcalde_tracker
# PGUSER=postgres
# PGPASSWORD=postgres
# PGPORT=5432

# --- Autenticación JWT del Panel Admin ---
JWT_SECRET=alcalde-tracker-dev-secret-cambiar-en-produccion
JWT_EXPIRES_IN=8h

# --- Admin por defecto (se crea automáticamente si no existe) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador del Sistema

PORT=3000